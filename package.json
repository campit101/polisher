{
  "name": "polisher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "e2e": "playwright test",
    "secret-scan": "node scripts/secret-scan.mjs",
    "verify": "node scripts/verify.mjs",
    "sync:usage": "node scripts/sync-usage.mjs",
    "measure:costs": "node scripts/measure-costs.ts",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@vercel/analytics": "2.0.1",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "23.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "lighthouse": "13.5.0",
    "secretlint": "13.0.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "63.1.2",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=22"
  }
}
