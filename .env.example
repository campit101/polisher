# Copy to .env.local for local development. Never commit real values.

# Site. LAUNCHED=true lets search engines in; leave it false for a private copy.
LAUNCHED=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated addresses that may open /admin.
ADMIN_EMAILS=you@example.com

# Supabase (use a separate test project for local development)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=

# Stripe, test mode only: the app and the build refuse any key not starting sk_test_, rk_test_ or pk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=price_xxx

# A long random value for hashing visitor addresses and signing form tokens (for example openssl rand -hex 32).
IP_HASH_SALT=

# Supabase Edge Function secrets are set in the Supabase dashboard, not here: ANTHROPIC_API_KEY.
# The daily AI spending ceiling and usage numbers live in src/config/usage.ts, not in env vars.
